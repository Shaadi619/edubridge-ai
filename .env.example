# Web
VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API
ENVIRONMENT=development
WEB_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional only for legacy HS256 Supabase projects; modern projects use JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edubridge

# AI routing. Tier 1 can be an OpenAI-compatible local server such as vLLM.
AI_TIER1_PROVIDER=openai
AI_TIER1_MODEL=
AI_TIER1_BASE_URL=
AI_TIER2_PROVIDER=openai
AI_TIER2_MODEL=
AI_TIER2_BASE_URL=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai
# Tune this cosine similarity cutoff with representative course questions.
TUTOR_MIN_SIMILARITY=0.30
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_TIER1_DEPLOYMENT=
AZURE_OPENAI_TIER2_DEPLOYMENT=
# Azure speech-to-text deployment, for example whisper-1 or gpt-4o-mini-transcribe.
AZURE_OPENAI_TRANSCRIPTION_ENDPOINT=
AZURE_OPENAI_TRANSCRIPTION_API_KEY=
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=
LOCAL_AI_API_KEY=local
